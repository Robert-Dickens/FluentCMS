<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(ClientCompatibility)</TargetFrameworks>
		<IsPackable>false</IsPackable>
		<GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
		<RootNamespace>FluentCMS</RootNamespace>
		<AssemblyName>ByteLabs.FluentCMS.$(MSBuildProjectName)</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Localization\**\*.json" />
	  <EmbeddedResource Include="Localization\**\*.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ByteLabs.Foundations.Ddd.Domain.Abstractions" />
		<PackageReference Include="ByteLabs.Foundations.Validation" />
		<PackageReference Include="ByteLabs.PlatformServices.Users.Abstractions" />
	</ItemGroup>

</Project>
