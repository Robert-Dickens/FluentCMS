    <Import Project="$(NuGetPackageRoot)meziantou.xunit.paralleltestframework\2.3.0\build\Meziantou.Xunit.ParallelTestFramework.props" Condition="Exists('$(NuGetPackageRoot)meziantou.xunit.paralleltestframework\2.3.0\build\Meziantou.Xunit.ParallelTestFramework.props')" />
