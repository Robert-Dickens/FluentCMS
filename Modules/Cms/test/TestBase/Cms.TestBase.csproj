<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="../common.test.xunit.props" />
	
	<PropertyGroup>
		<GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
		<RootNamespace>FluentCMS</RootNamespace>
		<AssemblyName>ByteLabs.FluentCMS.$(MSBuildProjectName)</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="appsettings.json" />
		<Content Include="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<None Remove="appsettings.secrets.json" />
		<Content Include="appsettings.secrets.json">
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ByteLabs.Foundations.Autofac" />
		<PackageReference Include="ByteLabs.Foundations.Authorization" />
		<PackageReference Include="ByteLabs.Foundations.TestFactory.Core" />
		<PackageReference Include="ByteLabs.Foundations.Mapperly" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Domain\Cms.Domain.csproj" />
	</ItemGroup>


</Project>
